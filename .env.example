# Copy to .env and fill in. Never commit .env.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres (with pgvector). Published on host port 5433 to avoid clashing with a local
# Postgres; docker compose points the API at "db:5432" inside the network.
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://jobcrm:jobcrm@localhost:5433/jobcrm
# Used by the test suite only. Tests wipe this database.
TEST_DATABASE_URL=postgresql://jobcrm:jobcrm@localhost:5433/jobcrm_test

# Redis. docker compose overrides the host to "redis" inside the network.
REDIS_URL=redis://localhost:6379/0

# Auth. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=1440
# Set to true when served over HTTPS.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# On a public deployment, only these emails may register (comma-separated). Required in production
# unless ALLOW_REGISTRATION=false.
ALLOWED_SIGNUP_EMAILS=
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000

# Web app -> API base URL (as seen from the browser). "/" = same origin, with the web app proxying
# /api/* to API_ORIGIN (production on Vercel; see docs/DEPLOYMENT.md).
NEXT_PUBLIC_API_URL=http://localhost:8000
API_ORIGIN=

# Where uploaded files are stored. Relative paths resolve from apps/api.
STORAGE_PATH=./storage
# local (disk at STORAGE_PATH) | database (Postgres; for hosts without a persistent shared disk)
STORAGE_BACKEND=local
# true: background jobs run in the worker process, no fork per job (small hosts)
WORKER_NO_FORK=false
# Delete jobs not seen for N days unless applied to or used for a resume/letter (0 = keep all)
JOB_RETENTION_DAYS=0

# Resume uploads
MAX_UPLOAD_BYTES=5242880
MAX_RESUME_PAGES=10
PARSE_JOB_TIMEOUT_SECONDS=120

# AI. gemini (default) | openai | none. With no key, resumes use the built-in basic parser.
# Resumes are only sent to the provider after the user turns on AI processing in Settings.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=60
# Hard cap per user per calendar month (input + output tokens).
LLM_MONTHLY_TOKEN_BUDGET=2000000
# Uploads/re-parses per user per window.
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=3600

# Job connectors
CONNECTOR_USER_AGENT=JobIntelligence/0.1 (personal job-search assistant)
CONNECTOR_TIMEOUT_SECONDS=20
# Pause between requests to the same source.
CONNECTOR_REQUEST_DELAY_SECONDS=1.0
MAX_GREENHOUSE_BOARDS=25
# Fictional jobs for Tier C sources (LinkedIn, Naukri, Indeed). Development only.
ENABLE_MOCK_CONNECTORS=false
SEARCH_RATE_LIMIT=30
SEARCH_RATE_WINDOW_SECONDS=3600

# Matching. Jobs embedded per scoring run (eligible ones first); keeps within free-tier quotas.
EMBEDDING_MAX_JOBS_PER_RUN=60

# Optional: Adzuna job search (register at developer.adzuna.com and accept their terms).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
